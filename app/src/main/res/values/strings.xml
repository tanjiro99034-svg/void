    <!-- Accessibility Disclosure Dialog -->
    <string name="disclosure_title">ENABLE ACCESSIBILITY SHIELD</string>
    <string name="disclosure_body">To detect and redirect away from Instagram Reels, YouTube Shorts, and Facebook Reels, VOID requires Android Accessibility Service access.</string>
    <string name="disclosure_point_1">Reads only active UI element IDs inside Instagram, YouTube, and Facebook.</string>
    <string name="disclosure_point_2">Redirects navigation when a restricted short-form video screen is entered.</string>
    <string name="disclosure_point_3">Leaves buttons intact where Android prevents modifying third-party apps; never collects or transmits personal data.</string>
